{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/golduck-front/browser",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "${API_ORIGIN}/api/$1", "env": ["API_ORIGIN"] },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
